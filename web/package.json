{
  "name": "formcompiler-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "lint": "biome check .",
    "format": "biome format --write .",
    "audit": "node e2e/audit.mjs",
    "e2e": "playwright test --grep-invert @matrix",
    "e2e:matrix": "rm -f test-results/matrix-rows.jsonl && playwright test matrix.spec.ts --grep @matrix"
  },
  "dependencies": {
    "@fontsource/archivo": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "jsonata": "2.2.2",
    "lucide-react": "1.77.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@playwright/test": "1.65.1",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "happy-dom": "21.0.4",
    "typescript": "7.0.2",
    "vite": "7.3.8",
    "vitest": "5.1.1"
  }
}
