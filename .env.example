# Skopiuj do .env (plik jest w .gitignore) i uzupełnij klucz.
# cp .env.example .env

# --- Model (hackathon: EdenAI, endpoint UE; decyzje D11, D20, D21) ---
LLM_ENABLED=true
LLM_ALLOW_REMOTE=true
LLM_BASE_URL=https://api.eu.edenai.run/v3
LLM_MODEL=flexai/Qwen3.5-9B@eu
LLM_API_KEY=
LLM_TIMEOUT_S=120

# Docelowo, model hostowany lokalnie (nieprzetestowane w czasie hackathonu):
# LLM_ALLOW_REMOTE=false
# LLM_BASE_URL=http://host.docker.internal:8080/v1
# LLM_MODEL=Qwen/Qwen3.5-9B  (w llama-server wyłącz tryb rozumowania w szablonie czatu)

# --- Narzędzia deweloperskie (devtools/), nigdy w usłudze ---
# Model czołowy do złotych IR i oceny; ten sam klucz EdenAI.
DEVTOOLS_REFERENCE_MODEL=anthropic/claude-sonnet-latest

# --- Upload i limity ---
MAX_UPLOAD_MB=20
MAX_PAGES=30
REQUEST_TIMEOUT_S=300
# Ochrona przed bombami dekompresyjnymi
MAX_ZIP_ENTRIES=1000
MAX_UNZIPPED_MB=200
MAX_IMAGE_PIXELS=120000000

# --- Uwierzytelnianie JWT (ARCHITECTURE 8.3) ---
AUTH_ENABLED=false
# Lista po przecinku; nie mieszaj HS* z RS*/ES*/PS*/EdDSA.
JWT_ALGORITHMS=RS256
# HS*: dokładnie jedno z JWT_SECRET i JWT_SECRET_FILE (np. /run/secrets/jwt)
JWT_SECRET=
JWT_SECRET_FILE=
# RS*/ES*/PS*/EdDSA: klucz publiczny PEM
JWT_PUBLIC_KEY=
JWT_ISSUER=
JWT_AUDIENCE=

# --- Sidecar Tika ---
TIKA_URL=http://localhost:9998
