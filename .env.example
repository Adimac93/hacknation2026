# Skopiuj do .env (plik jest w .gitignore) i uzupełnij klucz.
# cp .env.example .env

# --- Model (hackathon: EdenAI, endpoint UE; decyzje D11, D20, D21) ---
LLM_ENABLED=true
LLM_ALLOW_REMOTE=true
LLM_BASE_URL=https://api.eu.edenai.run/v3
LLM_MODEL=mistral/ministral-8b-2512@eu
LLM_API_KEY=
LLM_TIMEOUT_S=120

# Docelowo, model hostowany lokalnie (nieprzetestowane w czasie hackathonu):
# LLM_ALLOW_REMOTE=false
# LLM_BASE_URL=http://host.docker.internal:8080/v1
# LLM_MODEL=mistralai/Ministral-3-8B-Instruct-2512

# --- Narzędzia deweloperskie (devtools/), nigdy w usłudze ---
# Model czołowy do złotych IR i oceny; ten sam klucz EdenAI.
DEVTOOLS_REFERENCE_MODEL=anthropic/claude-sonnet-latest

# --- Upload i limity ---
MAX_UPLOAD_MB=20
MAX_PAGES=30
REQUEST_TIMEOUT_S=300

# --- Sidecar Tika ---
TIKA_URL=http://localhost:9998
